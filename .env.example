# Fill the real key only in .env on the backend computer; never in frontend files.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# After setting the key, restart and use Settings > Test to list real model IDs.
# Copy one returned ID here in .env, then stop/start again. No assumed model ID.
DEEPSEEK_MODEL=
# LAN access code is generated by start.bat if empty.
CAMPUSAI_ACCESS_CODE=
